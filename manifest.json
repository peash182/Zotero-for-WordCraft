{
  "manifest_version": 2,
  "name": "WordCraft Connector",
  "version": "0.1.0",
  "description": "Cite items from Zotero straight into a running WordCraft document.",
  "homepage_url": "https://github.com/peash182/Zotero-for-WordCraft",
  "applications": {
    "zotero": {
      "id": "wordcraft-zotero@wordcraft.local",
      "update_url": "https://raw.githubusercontent.com/peash182/Zotero-for-WordCraft/main/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "10.*"
    }
  }
}
